#!/usr/bin/env bash
#ddev-generated
# ddev-worktree: pre-push safety hook
# Confirms all pushes with context banner.
# Requires typing the branch name when a protected branch is being updated.
# Requires extra confirmation when force-pushing.
# Protection is decided per PUSHED REF (stdin), not the checked-out branch —
# so `git push origin HEAD:main` from a feature branch is still caught.

BOLD='\033[1m'; CYAN='\033[0;36m'; GREEN='\033[0;32m'
YELLOW='\033[1;33m'; RED='\033[0;31m'; DIM='\033[2m'
BLUE='\033[0;34m'; NC='\033[0m'

# Read remote and URL from hook arguments
REMOTE="$1"
REMOTE_URL="$2"

WORKTREE_PATH=$(git rev-parse --show-toplevel 2>/dev/null || echo "$PWD")
WORKTREE_NAME=$(basename "$WORKTREE_PATH")
BRANCH=$(git branch --show-current 2>/dev/null || echo "detached HEAD")

IS_WORKTREE=false
[[ -f "${WORKTREE_PATH}/.git" ]] && IS_WORKTREE=true

# Count commits about to be pushed
COMMIT_COUNT=$(git rev-list --count "@{u}.." 2>/dev/null || echo "?")

# ── Protected branches: defaults + .ddev/worktree.yaml entries ────────────────
# NOTE: this hook is a standalone artifact copied into .git/hooks/ — it cannot
# rely on the add-on's shared library, so the small YAML list parser below is
# deliberately duplicated (kept in sync with _wt_yaml_list in worktree-lib).
# Do NOT parse this with an awk range (/key:/,/^[^ ]/): in awk the end pattern
# is tested against the SAME record that starts the range, so a top-level key
# closes the range on its own line and the list items are never emitted.
_config_protected_branches() {
  local file="$1" line v rest e inlist=0
  [[ -f "$file" ]] || return 0
  while IFS= read -r line; do
    if [[ "$line" == protected_branches:* ]]; then
      v="${line#protected_branches:}"; v="${v%%#*}"
      if [[ "$v" == *"["*"]"* ]]; then         # flow style: [a, b, c]
        rest="${v#*\[}"; rest="${rest%%\]*},"
        while [[ -n "$rest" ]]; do
          e="${rest%%,*}"; rest="${rest#*,}"
          e=$(printf '%s' "$e" | xargs 2>/dev/null)
          e="${e#[\"\']}"; e="${e%[\"\']}"
          [[ -n "$e" ]] && printf '%s\n' "$e"
        done
        return 0
      fi
      inlist=1; continue
    fi
    (( inlist )) || continue
    if [[ "$line" =~ ^[[:space:]]+-[[:space:]]* ]]; then  # block style: "  - a"
      e="${line#*-}"; e="${e%%#*}"
      e=$(printf '%s' "$e" | xargs 2>/dev/null)
      e="${e#[\"\']}"; e="${e%[\"\']}"
      [[ -n "$e" ]] && printf '%s\n' "$e"
    elif [[ "$line" =~ ^[^[:space:]#] ]]; then
      inlist=0
    fi
  done < "$file"
}

PROTECTED_BRANCHES="main master develop production staging"
while IFS= read -r _extra; do
  [[ -z "$_extra" ]] && continue
  case " $PROTECTED_BRANCHES " in
    *" $_extra "*) ;;
    *) PROTECTED_BRANCHES="$PROTECTED_BRANCHES $_extra" ;;
  esac
done < <(_config_protected_branches "${WORKTREE_PATH}/.ddev/worktree.yaml")

_is_protected() {
  local pb
  for pb in $PROTECTED_BRANCHES; do
    [[ "$1" == "$pb" ]] && return 0
  done
  return 1
}

# ── Inspect the refs actually being pushed (stdin) ────────────────────────────
# stdin lines: <local-ref> <local-sha> <remote-ref> <remote-sha>
# Git does NOT put a leading '+' on stdin for force pushes. A force push is a
# non-fast-forward update: the remote tip is not an ancestor of what we're
# about to push. Detect that directly.
IS_FORCE=false
ANY_PROTECTED=false
PROTECTED_TARGET=""
FORCE_PROTECTED=""
PUSHED_LIST=""

PUSH_STDIN=$(cat)
while read -r _local_ref _local_sha _remote_ref _remote_sha; do
  [[ -z "$_local_ref" ]] && continue
  # Branch deletion (local sha all zeros) is not a force push.
  [[ "$_local_sha" =~ ^0+$ ]] && continue

  _target="${_remote_ref#refs/heads/}"
  PUSHED_LIST="${PUSHED_LIST:+${PUSHED_LIST}, }${_target}"

  _ref_force=false
  # Brand-new remote branch (remote sha all zeros) is a fast-forward by definition.
  if ! [[ "$_remote_sha" =~ ^0+$ ]]; then
    # Only judge if we actually have the remote object locally; otherwise we
    # can't tell a rewrite from a stale local view, so we don't flag (the
    # remote would reject a genuine non-ff anyway).
    if git cat-file -e "$_remote_sha" 2>/dev/null; then
      if ! git merge-base --is-ancestor "$_remote_sha" "$_local_sha" 2>/dev/null; then
        _ref_force=true
        IS_FORCE=true
      fi
    fi
  fi

  if _is_protected "$_target"; then
    ANY_PROTECTED=true
    [[ -z "$PROTECTED_TARGET" ]] && PROTECTED_TARGET="$_target"
    [[ "$_ref_force" == "true" ]] && FORCE_PROTECTED="$_target"
  fi
done <<< "$PUSH_STDIN"

# ── Detect TTY availability ───────────────────────────────────────────────────
# stdin in pre-push carries the refspec, not a terminal. Re-open from /dev/tty
# for interactive prompts. If /dev/tty is unavailable (IDE push, CI, pipe),
# suppress the error and fall back to non-interactive mode. The group wrapper
# matters: redirections apply left-to-right, so a bare `exec </dev/tty 2>...`
# would print the open error before stderr is redirected.
{ exec </dev/tty; } 2>/dev/null || true
HAS_TTY=false
[[ -t 0 ]] && HAS_TTY=true

echo ""

# ── Banner ────────────────────────────────────────────────────────────────────
if $ANY_PROTECTED; then
  echo -e "  ${RED}${BOLD}◈ GIT PUSH — PROTECTED BRANCH${NC}"
elif $IS_WORKTREE; then
  echo -e "  ${CYAN}${BOLD}◈ GIT PUSH — WORKTREE${NC}"
else
  echo -e "  ${GREEN}${BOLD}◈ GIT PUSH${NC}"
fi

echo ""
echo -e "  ${DIM}Worktree  :${NC} ${WORKTREE_NAME} ${DIM}(${WORKTREE_PATH})${NC}"
echo -e "  ${DIM}Branch    :${NC} ${BOLD}${BRANCH}${NC}"
echo -e "  ${DIM}Updates   :${NC} ${BOLD}${PUSHED_LIST:-"(nothing)"}${NC} ${DIM}→${NC} ${REMOTE}"
echo -e "  ${DIM}Remote URL:${NC} ${REMOTE_URL}"
echo -e "  ${DIM}Commits   :${NC} ${COMMIT_COUNT} commit(s) will be pushed"

if $IS_FORCE; then
  echo ""
  echo -e "  ${RED}${BOLD}⚠  FORCE PUSH DETECTED${NC}"
  echo -e "  ${RED}   This will overwrite the remote branch history.${NC}"
fi

echo ""

# ── Abort if force push to a protected branch ─────────────────────────────────
if [[ -n "$FORCE_PROTECTED" ]]; then
  echo -e "  ${RED}${BOLD}✗  Force push to '${FORCE_PROTECTED}' is blocked.${NC}"
  echo -e "  ${RED}   This safeguard cannot be bypassed.${NC}"
  echo ""
  exit 1
fi

# ── Confirm regular push ──────────────────────────────────────────────────────
if ! $ANY_PROTECTED; then
  if $HAS_TTY; then
    read -r -p "  Push ${COMMIT_COUNT} commit(s) to ${REMOTE} (${PUSHED_LIST:-$BRANCH})? [y/N] " answer
    case "$answer" in
      [yY]|[yY][eE][sS]) ;;
      *) echo -e "\n  ${YELLOW}Push aborted.${NC}\n"; exit 1 ;;
    esac

    if $IS_FORCE; then
      echo ""
      read -r -p "  Confirm FORCE push — this rewrites remote history. Type 'force' to proceed: " force_confirm
      if [[ "$force_confirm" != "force" ]]; then
        echo -e "\n  ${YELLOW}Push aborted.${NC}\n"
        exit 1
      fi
    fi
  fi
  # Non-interactive (IDE, CI): allow push without prompting
fi

# ── Protected branch: require typing the branch name ─────────────────────────
if $ANY_PROTECTED; then
  if $HAS_TTY; then
    echo -e "  ${RED}${BOLD}You are pushing to a protected branch: ${PROTECTED_TARGET}${NC}"
    echo ""
    read -r -p "  Type the branch name '${PROTECTED_TARGET}' to confirm: " typed_branch
    if [[ "$typed_branch" != "$PROTECTED_TARGET" ]]; then
      echo -e "\n  ${YELLOW}Branch name did not match. Push aborted.${NC}\n"
      exit 1
    fi
  else
    echo -e "  ${YELLOW}⚠  Non-interactive push to protected branch — skipping confirmation.${NC}"
    echo -e "  ${DIM}   Push from a terminal to be prompted for branch-name confirmation.${NC}"
    echo ""
  fi
fi

echo ""
echo -e "  ${GREEN}✓ Push confirmed.${NC}"
echo ""
exit 0
